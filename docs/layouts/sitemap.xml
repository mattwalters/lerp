{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- $version := site.Params.version -}}
{{- if eq $version "" -}}
  {{- range site.Pages -}}
    {{- if not (partial "manual.html" .) }}
  <url>
    <loc>{{ partial "canonical.html" . }}</loc>
  </url>
    {{- end -}}
  {{- end -}}
{{- else if eq $version "latest" -}}
  {{- range site.Pages -}}
    {{- if partial "manual.html" . }}
  <url>
    <loc>{{ partial "canonical.html" . }}</loc>
  </url>
    {{- end -}}
  {{- end -}}
{{- end }}
</urlset>
